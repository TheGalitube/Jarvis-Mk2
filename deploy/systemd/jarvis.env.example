# Copy to /etc/jarvis/jarvis.env and restrict it with chmod 600.
# Never commit the real file.

JARVIS_BIND_HOST=127.0.0.1
JARVIS_ALLOWED_HOSTS=mainpi5.tail05c33e.ts.net
JARVIS_CONFIG_FILE=/opt/jarvis/data/runtime-config.json
JARVIS_TTS_PROVIDER=openai
OPENAI_API_KEY=replace-with-a-rotated-openai-key

# Optional Telegram text and voice interface. Create the bot with @BotFather.
# Restrict it to your own numeric Telegram chat ID (comma-separated for more).
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_ALLOWED_CHAT_IDS=
