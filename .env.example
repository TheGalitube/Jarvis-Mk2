# Shared server-side OpenAI secret. On the STT server it is used only by the
# STT gateway; on a Jarvis app server it can also be used by the existing TTS
# configuration. Never put it in runtime-config.json or browser code.
OPENAI_API_KEY=
# Jarvis app server: expose the persisted Cloud-STT preference only when its
# LAN gateway is configured. This value contains no secret.
JARVIS_STT_GATEWAY_CLOUD_OPT_IN_ENABLED=false
