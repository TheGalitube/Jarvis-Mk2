{
  "jarvis": {
    "name": "Jarvis"
  },
  "agent": {
    "autonomyMode": "supervised"
  },
  "execution": {
    "securityProfile": "sandbox-only",
    "defaultTarget": "sandbox"
  },
  "targets": {
    "sandbox": {
      "enabled": true
    },
    "local": {
      "enabled": false,
      "safeRoots": [
        "/home/jarvis"
      ],
      "shellEnabled": false
    }
  },
  "hosts": {},
  "voice": {
    "mode": "voice-activation",
    "wakeWords": [
      "jarvis",
      "hey jarvis"
    ],
    "silenceTimeoutMs": 1400
  },
  "stt": {
    "provider": "auto",
    "fallbackToChrome": true,
    "chrome": {
      "enabled": true,
      "language": "de-DE"
    },
    "openai": {
      "model": "gpt-4o-transcribe",
      "language": "de",
      "timeoutMs": 20000
    },
    "nemotron": {
      "endpoint": null,
      "language": "auto",
      "timeoutMs": 5000
    },
    "whispercpp": {
      "endpoint": null,
      "language": "de",
      "timeoutMs": 20000
    },
    "gateway": {
      "cloudOptInEnabled": false
    }
  }
}
